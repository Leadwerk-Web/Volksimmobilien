# Block direct web access to static import sources, except public media fallbacks.
<IfModule mod_authz_core.c>
	Require all denied
	<FilesMatch "\.(webp|jpe?g|png|gif|svg|mp4|webm|mov|ico|woff2?)$">
		Require all granted
	</FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
	Order deny,allow
	Deny from all
	<FilesMatch "\.(webp|jpe?g|png|gif|svg|mp4|webm|mov|ico|woff2?)$">
		Allow from all
	</FilesMatch>
</IfModule>
